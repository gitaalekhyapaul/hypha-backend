# Copy to ignored .env.ngrok for a standalone Mac tunnel.
# For integrated VM startup, put these two values in the existing .env.m6 instead.
RAZIEL_NGROK_URL=https://either-anymore-immunize.ngrok-free.dev
NGROK_AUTHTOKEN=replace-with-your-private-ngrok-authtoken

# Standalone Docker Desktop route only. M6 integration always targets demo-console.
RAZIEL_NGROK_UPSTREAM=http://host.docker.internal:3000
