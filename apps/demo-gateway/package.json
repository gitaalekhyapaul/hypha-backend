{
  "name": "@raziel/demo-gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "format": "biome format --write app src test next.config.ts package.json tsconfig.json",
    "format:check": "biome format app src test next.config.ts package.json tsconfig.json",
    "lint": "biome lint app src test next.config.ts",
    "typecheck": "tsc --noEmit",
    "build": "next build",
    "test": "vitest run"
  },
  "dependencies": {
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "redis": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
