#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

if [ "${RAZIEL_SP1_BENCHMARK_CAPTURED:-0}" != 1 ]; then
  report_directory=.sp1/benchmarks
  mkdir -p "$report_directory"
  report_id=${RAZIEL_SP1_BENCHMARK_REPORT_ID:-"$(date -u +%Y%m%dT%H%M%SZ)-$$"}
  case "$report_id" in
    *[!A-Za-z0-9._-]* | "")
      echo "benchmark report ID contains unsupported characters" >&2
      exit 1
      ;;
  esac
  report_in_progress="$report_directory/$report_id.in-progress.log"
  set +e
  RAZIEL_SP1_BENCHMARK_CAPTURED=1 "$0" >"$report_in_progress" 2>&1
  status=$?
  set -e
  cat "$report_in_progress"
  if [ "$status" -eq 0 ]; then
    report_path="$report_directory/$report_id.pass.log"
  else
    report_path="$report_directory/$report_id.fail.log"
  fi
  mv "$report_in_progress" "$report_path"
  printf 'benchmark_report=%s\n' "$report_path"
  exit "$status"
fi

lock_parent=.sp1/locks
lock_directory=$lock_parent/sp1-plonk-benchmark
mkdir -p "$lock_parent"
if ! mkdir "$lock_directory"; then
  echo "another SP1 Plonk benchmark holds $lock_directory" >&2
  exit 1
fi
release_lock() {
  rmdir "$lock_directory"
}
trap release_lock EXIT

export HOST_UID=$(id -u)
export HOST_GID=$(id -g)

printf 'benchmark_profile=%s\n' \
  "${RAZIEL_SP1_BENCHMARK_PROFILE:-local-30g}"
if [ -n "${RAZIEL_CLUSTER_NAME:-}" ]; then
  printf 'cluster_name=%s\n' "$RAZIEL_CLUSTER_NAME"
fi
if [ -n "${RAZIEL_CLUSTER_SCHEDULER:-}" ]; then
  printf 'cluster_scheduler=%s\n' "$RAZIEL_CLUSTER_SCHEDULER"
fi
printf 'source_git_commit=%s\n' "$(git rev-parse HEAD)"
printf 'source_git_tree=%s\n' "$(git rev-parse 'HEAD^{tree}')"
if git diff --quiet && git diff --cached --quiet; then
  printf 'source_git_status=clean\n'
else
  printf 'source_git_status=dirty\n'
fi
docker version --format 'docker_client={{.Client.Version}} docker_server={{.Server.Version}}'
printf 'container_runtime=docker\n'
printf 'host_kernel_name=%s\n' "$(uname -s)"
printf 'host_kernel_release=%s\n' "$(uname -r)"
printf 'host_architecture=%s\n' "$(uname -m)"
case "$(uname -s)" in
  Darwin)
    printf 'host_hardware_model=%s\n' "$(sysctl -n hw.model)"
    printf 'host_cpu_model=%s\n' "$(sysctl -n machdep.cpu.brand_string)"
    ;;
  Linux)
    if [ -r /sys/devices/virtual/dmi/id/product_name ]; then
      printf 'host_hardware_model=%s\n' \
        "$(cat /sys/devices/virtual/dmi/id/product_name)"
    fi
    ;;
esac

docker compose \
  --env-file tools/toolchain-versions.env \
  build toolchain
printf 'toolchain_image_id=%s\n' \
  "$(docker image inspect --format '{{.Id}}' raziel-toolchain:m0)"

docker compose \
  --env-file tools/toolchain-versions.env \
  run --rm \
  --user "$HOST_UID:$HOST_GID" \
  --env RAZIEL_SP1_SETUP_DOWNLOAD_ONLY=1 \
  toolchain \
  ./scripts/setup-sp1-plonk-artifacts

docker compose \
  --env-file tools/toolchain-versions.env \
  run --rm toolchain \
  pnpm bootstrap:check

docker compose \
  --env-file tools/toolchain-versions.env \
  run --rm toolchain \
  cargo fetch --locked

docker compose \
  --env-file tools/toolchain-versions.env \
  run --rm \
  --user "$HOST_UID:$HOST_GID" \
  toolchain \
  ./scripts/setup-sp1-plonk-artifacts

docker compose \
  --env-file tools/toolchain-versions.env \
  run --rm toolchain \
  ./scripts/check-sp1-features

docker compose \
  --env-file tools/toolchain-versions.env \
  run --rm toolchain \
  cargo prove build --locked --packages raziel-authorization-guest

docker compose \
  --env-file tools/toolchain-versions.env \
  run --rm toolchain \
  node ./scripts/prepare-sp1-plonk-benchmark.mjs

docker compose \
  --env-file tools/toolchain-versions.env \
  --profile benchmark \
  run --rm sp1-plonk-benchmark
