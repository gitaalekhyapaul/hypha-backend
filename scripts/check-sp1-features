#!/bin/sh
set -eu

proving_feature_tree=$(cargo tree --locked --offline -e features -i sp1-sdk@6.3.1)

case "$proving_feature_tree" in
  *'sp1-sdk feature "blocking"'*) ;;
  *)
    echo "SP1 blocking feature is missing" >&2
    exit 1
    ;;
esac

case "$proving_feature_tree" in
  *'sp1-sdk feature "native-gnark"'*) ;;
  *)
    echo "SP1 native-gnark feature is missing" >&2
    exit 1
    ;;
esac

for forbidden_feature in network cuda experimental; do
  case "$proving_feature_tree" in
    *"sp1-sdk feature \"$forbidden_feature\""*)
      echo "forbidden SP1 feature is active: $forbidden_feature" >&2
      exit 1
      ;;
  esac
done

verifier_tree=$(cargo tree --locked --offline -p verifierd --prefix none --format '{p}')
service_contract_tree=$(
  cargo tree --locked --offline -p raziel-proto --features services --prefix none --format '{p}'
)
message_tree=$(
  cargo tree --locked --offline -p raziel-proto --no-default-features --prefix none --format '{p}'
)
guest_tree=$(
  cargo tree --locked --offline -p raziel-authorization-guest --prefix none --format '{p}'
)

case "
$verifier_tree
" in
  *"
sp1-verifier v6.3.1
"*) ;;
  *)
    echo "SP1 direct verifier is missing from verifierd" >&2
    exit 1
    ;;
esac

for forbidden_package in \
  "sp1-sdk" \
  "sp1-prover" \
  "sp1-prover-types" \
  "sp1-core-executor" \
  "sp1-core-executor-runner" \
  "sp1-core-machine" \
  "sp1-jit" \
  "sp1-recursion-gnark-ffi" \
  "aws-config" \
  "aws-sdk-kms" \
  "reqwest" \
  "reqwest-middleware" \
  "twirp-rs"
do
  case "
$verifier_tree
" in
    *"
$forbidden_package "*)
      echo "forbidden package is active in verifierd: $forbidden_package" >&2
      exit 1
      ;;
  esac
done

for required_package in "tonic v0.14.6" "tonic-prost v0.14.6"; do
  case "
$service_contract_tree
" in
    *"
$required_package
"*) ;;
    *)
      echo "required service contract package is missing: $required_package" >&2
      exit 1
      ;;
  esac
done

check_rpc_free() {
  graph_name=$1
  graph=$2

  for forbidden_package in \
    "tonic" \
    "tonic-prost" \
    "tokio" \
    "tokio-stream" \
    "http" \
    "http-body" \
    "http-body-util" \
    "h2" \
    "hyper" \
    "hyper-timeout" \
    "hyper-util" \
    "tower" \
    "tower-layer" \
    "tower-service" \
    "axum"
  do
    case "
$graph
" in
      *"
$forbidden_package "*)
        echo "forbidden RPC package is active in $graph_name: $forbidden_package" >&2
        exit 1
        ;;
    esac
  done
}

check_rpc_free "message-only raziel-proto" "$message_tree"
check_rpc_free "authorization guest" "$guest_tree"

printf '%s\n' "$proving_feature_tree"
echo "verifier_feature_tree=pass"
echo "service_contract_feature_tree=pass"
echo "message_and_guest_rpc_exclusion=pass"
