#!/bin/sh
set -eu
umask 022

runtime_root=${RAZIEL_PROOF_RUNTIME_ROOT:-/opt/raziel-runtime}
target_root=${CARGO_TARGET_DIR:-/var/cache/raziel-proof-build}
guest_root="$PWD/tools/authorization-guest"
guest_stage=$(mktemp -d "${TMPDIR:-/tmp}/raziel-approved-guest.XXXXXX")
guest_elf="$guest_stage/approved-v1.elf"

cleanup() {
  rm -f "$guest_elf"
  rmdir "$guest_stage" 2>/dev/null || true
}
trap cleanup EXIT HUP INT TERM

# Git preserves executable bits, not an exact mode. Validate the installed copy.
test -f "$guest_root/approved-v1.elf" && test ! -L "$guest_root/approved-v1.elf"
install -m 0444 "$guest_root/approved-v1.elf" "$guest_elf"
(cd "$guest_stage" && sha256sum --check "$guest_root/SHA256SUMS")

./scripts/prepare-sp1-native-dependencies --check

cargo build \
  --locked \
  --offline \
  --release \
  -p razield \
  --features one-shot-prover \
  --bin razield-proof-launcher \
  --bin razield-prover

test -x "$target_root/release/razield-proof-launcher"
test -x "$target_root/release/razield-prover"
test -s "$guest_elf"

RAZIEL_GUEST_ELF_PATH="$guest_elf" \
RAZIEL_EXPECTED_VERIFICATION_KEY_ID="$(sed -n '1p' services/verifierd/tests/fixtures/retained-plonk-v1/verification-key-id.txt)" \
RAZIEL_EXPECTED_SP1_VKEY_HASH="$(sed -n '1p' services/verifierd/tests/fixtures/retained-plonk-v1/sp1-vkey-hash.txt)" \
  "$target_root/release/razield-prover" --check-program-key

install -d -m 0755 "$runtime_root"
install -m 0555 "$target_root/release/razield-proof-launcher" "$runtime_root/razield-proof-launcher"
install -m 0555 "$target_root/release/razield-prover" "$runtime_root/razield-prover"
install -m 0444 "$guest_elf" "$runtime_root/raziel-authorization-guest"

manifest="$runtime_root/manifest.sha256"
temporary_manifest="$runtime_root/.manifest.sha256.tmp"
(
  cd "$runtime_root"
  sha256sum \
    razield-proof-launcher \
    razield-prover \
    raziel-authorization-guest \
    >"$temporary_manifest"
)
chmod 0444 "$temporary_manifest"
mv -f "$temporary_manifest" "$manifest"
