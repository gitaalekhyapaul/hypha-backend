#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
exec node --input-type=module - "$repo_root" <<'NODE'
import assert from "node:assert/strict";
import { execFileSync } from "node:child_process";
import { resolve } from "node:path";

const root = process.argv[2];
const config = JSON.parse(execFileSync(resolve(root, "scripts/compose-m6"),
  ["--profile", "*", "config", "--format", "json"], {
    cwd: root, encoding: "utf8", stdio: ["ignore", "pipe", "pipe"],
    env: { ...process.env, RAZIEL_M6_ENV_FILE: "/dev/null",
      RAZIEL_M6_POSTGRES_PASSWORD: "render-check-only", RAZIEL_M6_CONSOLE_PORT: "3000" },
  }));
const s = config.services;
assert.equal(config.name, "raziel-m6-live");
for (const [name, role] of Object.entries(s)) {
  assert.equal(role.build, undefined);
  assert.equal(role.pull_policy, "never");
  assert.equal(role.privileged ?? false, false);
  for (const [dependency, settings] of Object.entries(role.depends_on ?? {})) {
    if (settings.condition === "service_healthy") {
      const healthcheck = s[dependency]?.healthcheck;
      assert.ok(healthcheck && !healthcheck.disable &&
        healthcheck.test?.length > 0 && healthcheck.test[0] !== "NONE",
        `${name}: healthy dependency ${dependency} needs a health check`);
    }
  }
  for (const mount of role.tmpfs ?? []) {
    assert.ok(mount.startsWith("/"), `${name}: tmpfs options must stay in one absolute mount entry`);
  }
  if (name !== "demo-console") assert.equal((role.ports ?? []).length, 0, name);
  for (const mount of role.volumes ?? []) {
    assert.notEqual(mount.source, "/var/run/docker.sock");
    if (mount.type === "bind" && mount.source.includes("/.raziel/")) {
      assert.ok(mount.source.startsWith(resolve(root, ".raziel/m6-live")), name);
    }
  }
}
for (const volume of Object.values(config.volumes)) {
  assert.equal(volume.external ?? false, false);
  assert.ok(volume.name.startsWith("raziel-m6-live_"));
}
for (const name of ["demo-console-policy-tools", "demo-console-init", "demo-console", "demo-gateway"]) {
  const mounts = s[name].volumes.filter((entry) => entry.target === "/var/lib/raziel/m6");
  assert.equal(mounts.length, 1, `${name}: runtime must stay outside the workspace mount`);
  assert.equal(mounts[0].source, resolve(root, ".raziel/m6-live"));
  assert.equal(mounts[0].read_only ?? false, false);
  assert.equal(s[name].volumes.some((entry) => entry.target === "/workspace/.raziel/m6"), false);
}
for (const name of ["demo-console-policy-tools", "demo-console-init"]) {
  assert.equal(s[name].volumes.find((entry) => entry.target === "/workspace").read_only, true);
}
for (const name of ["demo-console", "demo-console-init"]) {
  assert.equal(s[name].environment.RAZIEL_OPERATOR_SECRET_PATH, "/var/lib/raziel/m6/operator-secret.json");
}
assert.equal(s["demo-console"].environment.RAZIEL_POLICY_CANDIDATE_ROOT, "/var/lib/raziel/m6/policy-candidates");
assert.equal(s["demo-console"].environment.RAZIEL_POLICY_VERSION_ROOT, "/var/lib/raziel/m6/policy-versions");
for (const name of ["demo-console", "demo-gateway"]) {
  assert.equal(s[name].environment.RAZIEL_RECEIPT_STORE_PATH, "/var/lib/raziel/m6/receipts.jsonl");
}
assert.equal(s["demo-gateway"].environment.RAZIEL_TRANSACTION_STORE_PATH, "/var/lib/raziel/m6/transactions.json");
for (const name of ["demo-access-graph", "demo-snapshot", "razield", "demo-capability-api",
  "demo-proof-worker", "verifierd"]) assert.equal(s[name], undefined);
assert.equal(config.networks["database-internal"].internal, true);
assert.deepEqual(Object.keys(s["m6-database"].networks), ["database-internal"]);
assert.ok(s.spicedb.command.includes("--datastore-engine=postgres"));
assert.equal(s.spicedb.depends_on["m6-spicedb-migrate"].condition, "service_completed_successfully");
assert.equal(s["m6-database"].image,
  "postgres@sha256:9b18b78397054fce88a9552e9d5a3ad5bb7fd258c5b3cc1c5028e46373d6ea8f");
const dispatcher = s["m6-dispatcher"];
assert.deepEqual(dispatcher.tmpfs, ["/tmp:rw,exec,nosuid,nodev,mode=0700,size=268435456"]);
assert.equal(dispatcher.environment.RAZIEL_ACCESS_PREFIX, s["demo-access-api"].environment.RAZIEL_ACCESS_PREFIX);
for (const name of ["m6-proof-worker", "m6-capability-api"]) {
  assert.equal(s[name].environment.RAZIEL_QUEUE_PREFIX, dispatcher.environment.RAZIEL_QUEUE_PREFIX);
}
for (const name of ["m6-proof-worker", "m6-proof-sandbox", "m6-verifierd", "demo-access-api",
  "demo-policy-authority", "demo-policy-activation", "demo-policy-registry-writer"]) {
  assert.equal(s[name].environment.RAZIEL_TRUST_DOMAIN_ID, dispatcher.environment.RAZIEL_TRUST_DOMAIN_ID, name);
}
assert.equal(dispatcher.environment.RAZIEL_ZED_TOKEN_CANDIDATE_ROOT, undefined);
assert.equal(dispatcher.environment.RAZIEL_ZED_TOKEN_PATH, undefined);
assert.equal(dispatcher.environment.RAZIEL_REGISTRY_WRITER_SOCKET_PATH,
  s["demo-policy-registry-writer"].environment.RAZIEL_REGISTRY_WRITER_SOCKET_PATH);
assert.equal(dispatcher.volumes.some(m => m.source === "m5-policy-secrets"), false);
assert.equal(s["m6-verifierd"].volumes.some(m => /snapshot|intent|envelope/.test(m.source)), false);
for (const [name, limit] of [["m6-proof-sandbox", 60129542144], ["m6-verifier-sandbox", 2147483648]]) {
  assert.equal(s[name].network_mode, "none");
  assert.equal(String(s[name].mem_limit), String(limit));
  assert.equal(String(s[name].memswap_limit), String(limit));
  assert.equal(s[name].read_only, true);
  assert.deepEqual(s[name].cap_drop, ["ALL"]);
}
assert.equal(s["m6-proof-sandbox"].cpuset, "0-7");
assert.equal(s["demo-gateway"].environment.RAZIEL_VERIFIERD_ENDPOINT, "http://m6-verifierd:50053");
assert.equal(s["demo-gateway"].environment.RAZIEL_DATASET_BINDING_MODE, "required");
assert.equal(s["demo-console"].ports[0].published, "3000");
assert.equal(s["demo-console"].ports[0].host_ip, "127.0.0.1");
assert.deepEqual(s["demo-console"].healthcheck.test.slice(0, 3), ["CMD", "node", "-e"]);
assert.ok(s["demo-console"].healthcheck.test[3].includes("http://127.0.0.1:3000/"));
process.stdout.write("m6_live_compose=pass proof=56GiB,8CPU,no-swap verifier=2GiB,no-network runtime=not-started\n");
NODE
