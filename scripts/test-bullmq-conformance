#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
project_name="raziel-queue-conformance-$$"

redis_password=$(od -An -N24 -tx1 /dev/urandom | tr -d ' \n')
if [ "${#redis_password}" -ne 48 ]; then
  echo "failed to generate the Redis conformance credential" >&2
  exit 1
fi

export RAZIEL_REDIS_PASSWORD=$redis_password
export RAZIEL_REDIS_USERNAME=raziel

compose() {
  "$repo_root/scripts/compose" --project-name "$project_name" "$@"
}

cleanup() {
  status=$?
  trap - 0 1 2 3 15
  compose --profile queue-conformance down --volumes --remove-orphans \
    >/dev/null 2>&1 || true
  exit "$status"
}
trap cleanup 0 1 2 3 15

run_case() {
  test_name=$1
  compose --profile queue-conformance run --rm --no-deps bullmq-conformance \
    cargo test --locked --offline -p razield --test bullmq_conformance \
    "$test_name" -- --exact --ignored --nocapture
}

cd "$repo_root"

# Populate the project-scoped Cargo cache before the isolated runner switches offline.
compose --profile queue-conformance build toolchain
compose --profile queue-conformance run --rm toolchain cargo fetch --locked

compose --profile queue-conformance up --detach --wait --wait-timeout 30 redis

run_case queue_lifecycle_conforms
run_case stalled_job_never_reinvokes_processor
run_case prepare_restart_recovery

compose --profile queue-conformance restart redis
compose --profile queue-conformance up --detach --wait --wait-timeout 30 redis

run_case verify_restart_recovery

echo "bullmq_redis_conformance=pass"
