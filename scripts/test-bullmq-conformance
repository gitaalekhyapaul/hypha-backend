#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
project_name="raziel-queue-conformance-$$"

redis_password=$(od -An -N24 -tx1 /dev/urandom | tr -d ' \n')
if [ "${#redis_password}" -ne 48 ]; then
  echo "failed to generate the Redis conformance credential" >&2
  exit 1
fi

export RAZIEL_REDIS_PASSWORD=$redis_password
export RAZIEL_REDIS_USERNAME=raziel

compose() {
  "$repo_root/scripts/compose" --project-name "$project_name" "$@"
}

cleanup() {
  status=$?
  trap - 0 1 2 3 15
  compose --profile queue-conformance down --volumes --remove-orphans \
    >/dev/null 2>&1 || true
  exit "$status"
}
trap cleanup 0 1 2 3 15

run_case() {
  test_name=$1
  compose --profile queue-conformance run --rm --no-deps bullmq-conformance \
    cargo test --locked --offline -p razield --test bullmq_conformance \
    "$test_name" -- --exact --ignored --nocapture
}

run_publication_case() {
  test_name=$1
  compose --profile queue-conformance run --rm --no-deps \
    --env RAZIEL_QUEUE_REJECT_REDIS_URL \
    bullmq-conformance \
    cargo test --locked --offline -p razield --test capability_publication \
    "$test_name" -- --exact --ignored --nocapture
}

run_service_case() {
  test_name=$1
  compose --profile queue-conformance run --rm --no-deps bullmq-conformance \
    cargo test --locked --offline -p razield --test capability_service \
    "$test_name" -- --exact --ignored --nocapture
}

run_worker_case() {
  test_name=$1
  compose --profile queue-conformance run --rm --no-deps bullmq-conformance \
    cargo test --locked --offline -p razield --lib \
    "worker::tests::$test_name" -- --exact --ignored --nocapture
}

cd "$repo_root"

# Populate the project-scoped Cargo cache before the isolated runner switches offline.
compose --profile queue-conformance build toolchain
compose --profile queue-conformance run --rm toolchain cargo fetch --locked

compose --profile queue-conformance up --detach --wait --wait-timeout 30 redis

reject_username=raziel-reject
reject_password=$(od -An -N24 -tx1 /dev/urandom | tr -d ' \n')
if [ "${#reject_password}" -ne 48 ]; then
  echo "failed to generate the restricted Redis credential" >&2
  exit 1
fi
compose --profile queue-conformance exec -T redis \
  redis-cli --no-auth-warning \
  --user "$RAZIEL_REDIS_USERNAME" --pass "$RAZIEL_REDIS_PASSWORD" \
  ACL SETUSER "$reject_username" reset on \
  ">$reject_password" '~*' '&*' '+@all' '-eval' '-evalsha' \
  >/dev/null
export RAZIEL_QUEUE_REJECT_REDIS_URL="redis://$reject_username:$reject_password@redis:6379/0"

run_case queue_lifecycle_conforms
run_case stalled_job_never_reinvokes_processor
run_publication_case publishes_minimal_waiting_job_and_returns_exact_duplicate
run_publication_case confirmed_live_rejection_removes_the_new_envelope
run_service_case live_create_uses_startup_reconciliation_and_returns_queued
run_worker_case live_worker_claims_one_job_and_retains_only_the_public_capability
run_case prepare_restart_recovery

compose --profile queue-conformance restart redis
compose --profile queue-conformance up --detach --wait --wait-timeout 30 redis

run_case verify_restart_recovery

echo "bullmq_redis_conformance=pass"
