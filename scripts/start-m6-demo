#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

for binary in razield-access-dispatch razield-capability razield-proof-worker verifierd raziel-verifier-client; do
  test -x ".raziel/m6-live-tools/$binary" || {
    printf 'missing M6 tool: %s; run ./scripts/prepare-m6-demo\n' "$binary" >&2
    exit 1
  }
done
test -d .sp1/circuits/plonk/v6.1.0 || {
  printf 'missing approved Plonk setup; follow SP1-PLONK-CLUSTER.md\n' >&2
  exit 1
}
# Compose's proof initializer checks VM memory before starting its 56 GiB cgroup.
# The existing no-swap, eight-CPU proof and 2 GiB verifier limits are unchanged.
exec ./scripts/compose-m6 --profile apps up --detach --wait --wait-timeout 900
