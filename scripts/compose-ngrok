#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"
environment=${RAZIEL_NGROK_ENV_FILE:-.env.ngrok}
if [ -f "$environment" ]; then
  set -- --env-file "$environment" "$@"
fi
exec ./scripts/compose -f docker-compose.ngrok.yml \
  --project-name raziel-ngrok --profile ngrok "$@"
