#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

for lockfile in pnpm-lock.yaml Cargo.lock; do
  if [ ! -f "$lockfile" ]; then
    echo "missing lockfile: $lockfile" >&2
    echo "run ./scripts/update-locks after maintainer approval" >&2
    exit 1
  fi
done

pnpm install --frozen-lockfile
cargo fetch --locked
if [ "$(id -u)" -eq 0 ]; then
  cargo_home=${CARGO_HOME:-"$HOME/.cargo"}
  for public_cache in "$cargo_home/registry" "$cargo_home/git"; do
    if [ -e "$public_cache" ]; then
      chmod -R a+rX "$public_cache"
    fi
  done
fi
(
  cd tools/spicedb-ir-compiler
  go mod download
)
pnpm generate
pnpm bootstrap:check
