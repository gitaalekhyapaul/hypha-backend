#!/bin/sh
set -eu
umask 022

crate_version=${RAZIEL_SP1_CRATE_VERSION:?RAZIEL_SP1_CRATE_VERSION is required}
cargo_home=${CARGO_HOME:-"$HOME/.cargo"}
go_mod_cache=${GOMODCACHE:?GOMODCACHE is required}
cached_modfile="$go_mod_cache/raziel-sp1-gnark.mod"
cached_sumfile="$go_mod_cache/raziel-sp1-gnark.sum"
temporary_modfile="$go_mod_cache/.raziel-sp1-gnark-$$.mod"
temporary_sumfile="$go_mod_cache/.raziel-sp1-gnark-$$.sum"
crate_root=
crate_count=0

cleanup() {
  rm -f "$temporary_modfile" "$temporary_sumfile"
}
trap cleanup EXIT HUP INT TERM

for candidate in \
  "$cargo_home"/registry/src/*/"sp1-recursion-gnark-ffi-$crate_version"
do
  if [ -d "$candidate" ] && [ ! -L "$candidate" ]; then
    crate_root=$candidate
    crate_count=$((crate_count + 1))
  fi
done

if [ "$crate_count" -ne 1 ]; then
  echo "expected one pinned sp1-recursion-gnark-ffi source, found $crate_count" >&2
  exit 1
fi
if [ ! -f "$crate_root/go/go.mod" ] || [ -L "$crate_root/go/go.mod" ] ||
  [ ! -f "$crate_root/go/go.sum" ] || [ -L "$crate_root/go/go.sum" ]
then
  echo "the pinned SP1 Gnark module manifest is missing or unsafe" >&2
  exit 1
fi

install -d -m 0755 "$go_mod_cache"
install -m 0600 "$crate_root/go/go.mod" "$temporary_modfile"
install -m 0600 "$crate_root/go/go.sum" "$temporary_sumfile"
(
  cd "$crate_root/go"
  GOFLAGS="-mod=mod -modfile=$temporary_modfile" go mod download all
  GOFLAGS="-mod=readonly -modfile=$temporary_modfile" GOPROXY=off go mod verify
)
chmod 0444 "$temporary_modfile" "$temporary_sumfile"
mv -f "$temporary_sumfile" "$cached_sumfile"
mv -f "$temporary_modfile" "$cached_modfile"
chmod -R a+rX "$go_mod_cache"
