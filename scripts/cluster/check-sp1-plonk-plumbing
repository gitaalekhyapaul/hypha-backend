#!/bin/sh
set -eu

script_directory=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$script_directory/../.." && pwd)
cd "$repo_root"

test_id="cluster-plumbing-self-test-$$"
raw_report=".sp1/benchmarks/$test_id.pass.log"
public_report="docs/benchmarks/sp1-plonk/$test_id.md"
independent_raw_report=".sp1/benchmarks/$test_id-independent.pass.log"
independent_public_report="docs/benchmarks/sp1-plonk/$test_id-independent.md"
wrong_profile_report=".sp1/benchmarks/$test_id-wrong-profile.pass.log"
wrong_profile_public_report="docs/benchmarks/sp1-plonk/$test_id-wrong-profile.md"
wrong_key_report=".sp1/benchmarks/$test_id-wrong-key.pass.log"
wrong_key_public_report="docs/benchmarks/sp1-plonk/$test_id-wrong-key.md"
duplicate_profile_report=".sp1/benchmarks/$test_id-duplicate-profile.pass.log"
duplicate_profile_public_report="docs/benchmarks/sp1-plonk/$test_id-duplicate-profile.md"
compose_output=$(mktemp /tmp/raziel-sp1-cluster-compose.XXXXXX)
retained_output=$(mktemp -d /tmp/raziel-sp1-retained-output.XXXXXX)
retained_fixture_root=$(mktemp -d /tmp/raziel-sp1-retained-fixture.XXXXXX)
retained_rejection_root=$(mktemp -d /tmp/raziel-sp1-retained-rejection.XXXXXX)

cleanup() {
  rm -f \
    "$raw_report" \
    "$public_report" \
    "$independent_raw_report" \
    "$independent_public_report" \
    "$wrong_profile_report" \
    "$wrong_profile_public_report" \
    "$wrong_key_report" \
    "$wrong_key_public_report" \
    "$duplicate_profile_report" \
    "$duplicate_profile_public_report" \
    "$compose_output"
  rm -rf \
    "$retained_output" \
    "$retained_fixture_root" \
    "$retained_rejection_root"
}
trap cleanup EXIT HUP INT TERM

. ./tools/toolchain-versions.env
. ./scripts/cluster/sp1-plonk-common
raziel_reject_container_runtime_environment
docker_context=$(docker context show)
docker_endpoint=$(
  docker context inspect \
    --format '{{.Endpoints.docker.Host}}' \
    "$docker_context"
)
raziel_require_local_docker_endpoint "$docker_endpoint"
node_check_source="$repo_root/scripts/download-sp1-plonk-artifact.mjs"
node_check_target=/workspace/download-sp1-plonk-artifact.mjs
node_check_mount="type=bind,src=$node_check_source,dst=$node_check_target,readonly"

sh -n \
  scripts/benchmark-sp1-plonk \
  scripts/run-sp1-plonk-benchmark \
  scripts/cluster/sp1-plonk-common \
  scripts/cluster/check-sp1-plonk-host \
  scripts/cluster/probe-sp1-plonk-container \
  scripts/cluster/probe-sp1-plonk-slurm \
  scripts/cluster/prepare-sp1-plonk \
  scripts/cluster/stage-sp1-plonk-run-bundle \
  scripts/cluster/run-sp1-plonk \
  scripts/cluster/render-sp1-plonk-result \
  scripts/cluster/stage-retained-sp1-plonk \
  scripts/cluster/slurm-probe-sp1-plonk \
  scripts/cluster/slurm-prepare-sp1-plonk \
  scripts/cluster/slurm-sp1-plonk
grep -Fqx '#SBATCH --cpus-per-task=8' scripts/cluster/slurm-sp1-plonk
docker run --rm \
  --cap-drop all \
  --network none \
  --pids-limit 64 \
  --read-only \
  --security-opt no-new-privileges \
  --user 65534:65534 \
  --mount "$node_check_mount" \
  "$NODE_IMAGE" \
  node --check "$node_check_target"

if raziel_runtime_help_has_option '  --memory-swap string' --memory; then
  echo "runtime option matching confused --memory with --memory-swap" >&2
  exit 1
fi
if ! raziel_runtime_help_has_option '  --memory string' --memory; then
  echo "runtime option matching rejected an exact --memory option" >&2
  exit 1
fi

if (
  export RAZIEL_CLUSTER_NAME=nus
  export RAZIEL_CLUSTER_RUNTIME=docker
  . ./scripts/cluster/sp1-plonk-common
  raziel_resolve_cluster_runtime
) >/dev/null 2>&1; then
  echo "NUS runtime selection accepted Docker" >&2
  exit 1
fi
independent_runtime=$(
  export RAZIEL_CLUSTER_NAME=independent
  export RAZIEL_CLUSTER_RUNTIME=docker
  . ./scripts/cluster/sp1-plonk-common
  raziel_resolve_cluster_runtime
)
if [ "$independent_runtime" != docker ]; then
  echo "independent-machine runtime selection rejected Docker" >&2
  exit 1
fi
if (
  unset SLURM_JOB_ID
  export RAZIEL_CLUSTER_NAME=nus
  . ./scripts/cluster/sp1-plonk-common
  raziel_resolve_cluster_scheduler
) >/dev/null 2>&1; then
  echo "NUS scheduler selection accepted an unscheduled invocation" >&2
  exit 1
fi
nus_scheduler=$(
  export RAZIEL_CLUSTER_NAME=nus
  export SLURM_JOB_ID=123
  . ./scripts/cluster/sp1-plonk-common
  raziel_resolve_cluster_scheduler
)
if [ "$nus_scheduler" != slurm ]; then
  echo "NUS scheduler selection rejected a Slurm invocation" >&2
  exit 1
fi
if (
  export RAZIEL_SP1_MEMORY_LIMIT=68719476736
  . ./scripts/cluster/sp1-plonk-common
  raziel_configure_cluster_proof_profile
) >/dev/null 2>&1; then
  echo "cluster profile accepted a memory override" >&2
  exit 1
fi
raziel_configure_cluster_proof_profile
if (
  export APPTAINER_BIND=/tmp:/workspace
  . ./scripts/cluster/sp1-plonk-common
  raziel_reject_container_runtime_environment
) >/dev/null 2>&1; then
  echo "cluster preflight accepted an Apptainer bind override" >&2
  exit 1
fi
if (
  . ./scripts/cluster/sp1-plonk-common
  raziel_require_local_docker_endpoint tcp://remote.example:2376
) >/dev/null 2>&1; then
  echo "cluster preflight accepted a remote Docker endpoint" >&2
  exit 1
fi
raziel_require_local_docker_endpoint unix:///var/run/docker.sock

docker compose \
  --env-file tools/toolchain-versions.env \
  --profile benchmark \
  config >"$compose_output"

grep -Fq 'cpuset: 0-7' "$compose_output"
grep -Fq 'mem_limit: "60129542144"' "$compose_output"
grep -Fq 'memswap_limit: "60129542144"' "$compose_output"
grep -Fq 'network_mode: none' "$compose_output"
grep -Fq 'GODEBUG: gctrace=1' "$compose_output"
grep -Fq 'RAZIEL_SP1_BENCHMARK_PROFILE: cluster-56g-8cpu' "$compose_output"
grep -Fq 'RAZIEL_SP1_EXPECTED_GO_DEBUG: gctrace=1' "$compose_output"
grep -Fq 'RAZIEL_SP1_EXPECTED_MEMORY_MAX_BYTES: "60129542144"' "$compose_output"
grep -Fq 'RAZIEL_SP1_EXPECTED_VISIBLE_CPUS: "8"' "$compose_output"
grep -Fq 'RAZIEL_SP1_RETAIN_PUBLIC_ARTIFACT=1' scripts/cluster/run-sp1-plonk
grep -Fq 'RAZIEL_SP1_PUBLIC_EXPORT_DIRECTORY=/public-output' scripts/cluster/run-sp1-plonk
grep -Fq 'crates/prover/tests/support/mod.rs' scripts/cluster/sp1-plonk-common
if grep -Fq "printf 'benchmark_profile=%s" scripts/cluster/run-sp1-plonk; then
  echo "cluster wrapper duplicates the in-container benchmark profile field" >&2
  exit 1
fi

mkdir -p .sp1/benchmarks
{
  printf 'benchmark_profile=cluster-56g-8cpu\n'
  printf 'cluster_name=nus\n'
  printf 'cluster_scheduler=slurm\n'
  printf 'cluster_job_id=secret-job-id\n'
  printf 'host_kernel=Linux secret-hostname\n'
  printf 'source_git_commit=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n'
  printf 'source_git_tree=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\n'
  printf 'source_git_status=clean\n'
  printf 'container_runtime=apptainer\n'
  printf 'container_runtime_version=1.4.2\n'
  printf 'toolchain_image_id=sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc\n'
  printf 'benchmark_utc=2026-07-28T00:00:00Z\n'
  printf 'architecture=x86_64\n'
  printf 'kernel_release=6.8.0\n'
  printf 'cpu_model=Test CPU\n'
  printf 'available_cpus=8\n'
  printf 'cpu_max=400000 100000\n'
  printf 'container_memory_max_bytes=60129542144\n'
  printf 'container_swap_max_bytes=0\n'
  printf 'go_max_procs=8\n'
  printf 'go_memory_limit=24GiB\n'
  printf 'go_debug=gctrace=1\n'
  printf 'rayon_threads=8\n'
  printf 'rustc_version=rustc 1.97.1\n'
  printf 'cargo_version=cargo 1.97.1\n'
  printf 'cargo_prove_version=sp1 6.3.1 commit 8252c29\n'
  printf 'sp1_plonk_setup_archive_sha256=dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd\n'
  printf 'source_manifest_sha256=eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee\n'
  printf 'run_bundle_manifest_sha256=1111111111111111111111111111111111111111111111111111111111111111\n'
  printf 'adr_0012_execute: proof_mode=plonk, fixture_id=direct, instructions=520000, execute_ms=306\n'
  printf 'adr_0012_prove: proof_mode=plonk, prove_ms=120000, artifact_bytes=4096, verification_key_id=sp1-vk-v1:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff\n'
  printf 'test local_plonk_verification_passes_the_adr_0012_gate ... adr_0012_verify: proof_mode=plonk, verify_ms=300, verification_key_id=sp1-vk-v1:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff\n'
  printf 'adr_0012_mutations=pass\n'
  printf 'b0031_public_export=pass\n'
  printf 'container_memory_peak_bytes=34359738368\n'
  printf 'container_swap_peak_bytes=0\n'
  printf 'container_oom_count=0\n'
  printf 'container_oom_kill_count=0\n'
} >"$raw_report"

./scripts/cluster/render-sp1-plonk-result "$raw_report" >/dev/null
grep -Fq 'Status: pass' "$public_report"
grep -Fq 'Memory limit bytes | `60129542144`' "$public_report"
grep -Fq 'Go memory diagnostics | `gctrace=1`' "$public_report"
if grep -Eq 'secret-job-id|secret-hostname' "$public_report"; then
  echo "public benchmark result copied a private raw-log identifier" >&2
  exit 1
fi

dd if=/dev/zero of="$retained_output/plonk-proof.bin" bs=4096 count=1 2>/dev/null
printf 'p' >"$retained_output/public-values.bin"
printf '0x%s' "$(printf '%064d' 0)" >"$retained_output/sp1-vkey-hash.txt"
printf 'sp1-vk-v1:%s' \
  ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff \
  >"$retained_output/verification-key-id.txt"
RAZIEL_CLUSTER_PLUMBING_SELF_TEST=1 \
RAZIEL_RETAINED_PLONK_FIXTURE_ROOT="$retained_fixture_root" \
  ./scripts/cluster/stage-retained-sp1-plonk \
  "$raw_report" \
  "$retained_output" \
  >/dev/null
retained_fixture="$retained_fixture_root/retained-plonk-v1"
(
  cd "$retained_fixture"
  sha256sum --check --strict SHA256SUMS >/dev/null
)
grep -Fqx 'classification=public-zero-knowledge-test-fixture' \
  "$retained_fixture/PROVENANCE"
grep -Fqx 'private_witness_retained=false' "$retained_fixture/PROVENANCE"
grep -Fqx 'debug_trace_retained=false' "$retained_fixture/PROVENANCE"

printf 'not public\n' >"$retained_output/unapproved-private-file"
if RAZIEL_CLUSTER_PLUMBING_SELF_TEST=1 \
  RAZIEL_RETAINED_PLONK_FIXTURE_ROOT="$retained_rejection_root" \
  ./scripts/cluster/stage-retained-sp1-plonk \
    "$raw_report" \
    "$retained_output" \
    >/dev/null 2>&1
then
  echo "retained proof staging accepted an unapproved output file" >&2
  exit 1
fi
rm "$retained_output/unapproved-private-file"
sed \
  -e 's/^cluster_name=nus$/cluster_name=independent/' \
  -e 's/^cluster_scheduler=slurm$/cluster_scheduler=unscheduled/' \
  -e 's/^container_runtime=apptainer$/container_runtime=docker/' \
  "$raw_report" >"$independent_raw_report"
./scripts/cluster/render-sp1-plonk-result "$independent_raw_report" >/dev/null
grep -Fq 'Status: pass' "$independent_public_report"

awk '
  /^benchmark_profile=/ { print }
  { print }
' "$raw_report" >"$duplicate_profile_report"
if ./scripts/cluster/render-sp1-plonk-result \
  "$duplicate_profile_report" >/dev/null 2>&1
then
  echo "public benchmark result accepted a duplicate profile by default" >&2
  exit 1
fi
./scripts/cluster/render-sp1-plonk-result \
  --recover-duplicate-profile \
  "$duplicate_profile_report" >/dev/null
grep -Fq 'Status: pass' "$duplicate_profile_public_report"
rm "$duplicate_profile_public_report"
awk '
  /^benchmark_profile=/ { print "benchmark_profile=cluster-64g" }
  { print }
' "$raw_report" >"$duplicate_profile_report"
if ./scripts/cluster/render-sp1-plonk-result \
  --recover-duplicate-profile \
  "$duplicate_profile_report" >/dev/null 2>&1
then
  echo "public benchmark recovery accepted conflicting profile values" >&2
  exit 1
fi

sed 's/^available_cpus=8$/available_cpus=4/' \
  "$raw_report" >"$wrong_profile_report"
if ./scripts/cluster/render-sp1-plonk-result "$wrong_profile_report" >/dev/null 2>&1; then
  echo "public benchmark result accepted CPU-affinity drift" >&2
  exit 1
fi
sed 's/^go_debug=gctrace=1$/go_debug=gctrace=0/' \
  "$raw_report" >"$wrong_profile_report"
if ./scripts/cluster/render-sp1-plonk-result "$wrong_profile_report" >/dev/null 2>&1; then
  echo "public benchmark result accepted Go diagnostic drift" >&2
  exit 1
fi
sed 's/^benchmark_profile=cluster-56g-8cpu$/benchmark_profile=cluster-64g/' \
  "$raw_report" >"$wrong_profile_report"
if ./scripts/cluster/render-sp1-plonk-result "$wrong_profile_report" >/dev/null 2>&1; then
  echo "public benchmark result accepted a different resource profile" >&2
  exit 1
fi
sed 's/instructions=520000/instructions=520001/' \
  "$raw_report" >"$wrong_profile_report"
if ./scripts/cluster/render-sp1-plonk-result "$wrong_profile_report" >/dev/null 2>&1; then
  echo "public benchmark result accepted instruction-count budget drift" >&2
  exit 1
fi
sed 's/artifact_bytes=4096/artifact_bytes=0/' \
  "$raw_report" >"$wrong_profile_report"
if ./scripts/cluster/render-sp1-plonk-result "$wrong_profile_report" >/dev/null 2>&1; then
  echo "public benchmark result accepted an empty proof artifact" >&2
  exit 1
fi
sed \
  's/^test local_plonk_verification_passes_the_adr_0012_gate \.\.\. /unexpected test prefix /' \
  "$raw_report" >"$wrong_key_report"
if ./scripts/cluster/render-sp1-plonk-result "$wrong_key_report" >/dev/null 2>&1; then
  echo "public benchmark result accepted an unknown test-harness prefix" >&2
  exit 1
fi
awk '
  /adr_0012_verify:/ {
    sub(/f+$/, "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
  }
  { print }
' "$raw_report" >"$wrong_key_report"
if ./scripts/cluster/render-sp1-plonk-result "$wrong_key_report" >/dev/null 2>&1; then
  echo "public benchmark result accepted mismatched proof and verification keys" >&2
  exit 1
fi

rm "$public_report"
printf 'source_git_status=clean\n' >>"$raw_report"
if ./scripts/cluster/render-sp1-plonk-result "$raw_report" >/dev/null 2>&1; then
  echo "public benchmark result accepted a duplicate required field" >&2
  exit 1
fi

printf 'sp1_plonk_cluster_plumbing=pass\n'
