#!/bin/sh
set -eu

script_directory=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$script_directory/sp1-plonk-common"

repo_root=$(CDPATH= cd -- "$script_directory/../.." && pwd)
cd "$repo_root"

export RAZIEL_CLUSTER_NAME=${RAZIEL_CLUSTER_NAME:-nus}
export RAZIEL_CLUSTER_PREFLIGHT_PHASE=prove
umask 077

if [ "${RAZIEL_SP1_CLUSTER_GATE_APPROVED:-0}" != 1 ]; then
  echo "the approved 56 GiB ADR-0012 cluster gate requires its approval flag" >&2
  exit 1
fi
raziel_configure_cluster_proof_profile

RAZIEL_CLUSTER_SCHEDULER=$(raziel_resolve_cluster_scheduler)
export RAZIEL_CLUSTER_SCHEDULER

prepared_value() {
  key=$1
  awk -v prefix="$key=" '
    index($0, prefix) == 1 {
      print substr($0, length(prefix) + 1)
      found = 1
    }
    END { exit found ? 0 : 1 }
  ' "$prepared_path"
}

./scripts/cluster/check-sp1-plonk-host
runtime=$(raziel_resolve_cluster_runtime)
lock_parent=.sp1/locks
operation_lock="$lock_parent/sp1-plonk-operation"
mkdir -p "$lock_parent"
chmod 700 .sp1 "$lock_parent"
if ! mkdir "$operation_lock"; then
  echo "another SP1 Plonk preparation or proof operation is active" >&2
  exit 1
fi
trap 'rmdir "$operation_lock"' EXIT HUP INT TERM
prepared_path=.sp1/cluster/sp1-plonk-prepared
if [ ! -f "$prepared_path" ] || [ -L "$prepared_path" ]; then
  echo "run ./scripts/cluster/prepare-sp1-plonk before submitting the proof job" >&2
  exit 1
fi

prepared_commit=$(prepared_value source_git_commit)
prepared_tree=$(prepared_value source_git_tree)
prepared_runtime=$(prepared_value container_runtime)
prepared_runtime_version=$(prepared_value container_runtime_version)
prepared_image_id=$(prepared_value toolchain_image_id)
prepared_test_executable_sha256=$(prepared_value test_executable_sha256)
prepared_guest_elf_sha256=$(prepared_value guest_elf_sha256)
prepared_setup_manifest_sha256=$(prepared_value plonk_setup_manifest_sha256)
prepared_run_bundle_manifest_sha256=$(prepared_value run_bundle_manifest_sha256)
if [ "$prepared_commit" != "$(git rev-parse HEAD)" ] ||
  [ "$prepared_tree" != "$(git rev-parse 'HEAD^{tree}')" ]
then
  echo "the prepared proof inputs do not match the current Git source" >&2
  exit 1
fi
if [ "$prepared_runtime" != "$runtime" ]; then
  echo "the prepared container runtime does not match the proof runtime" >&2
  exit 1
fi
case "$runtime" in
  docker)
    current_image_id=$(docker image inspect --format '{{.Id}}' raziel-toolchain:m0)
    current_runtime_version=$(docker version --format '{{.Client.Version}}/{{.Server.Version}}')
    ;;
  apptainer | singularity)
    current_image_id="sha256:$(raziel_sha256_file "$RAZIEL_SP1_TOOLCHAIN_SIF")"
    current_runtime_version=$("$runtime" version)
    ;;
esac
if [ "$prepared_image_id" != "$current_image_id" ]; then
  echo "the prepared toolchain image changed before the proof job" >&2
  exit 1
fi
if [ "$prepared_runtime_version" != "$current_runtime_version" ]; then
  echo "the container runtime version changed after preparation" >&2
  exit 1
fi

run_bundle="$repo_root/.sp1/cluster/sp1-plonk-run-bundle"
raziel_verify_run_bundle "$run_bundle"
if [ "$prepared_run_bundle_manifest_sha256" != \
  "$(raziel_sha256_file "$run_bundle/RAZIEL-RUN-BUNDLE-SHA256")" ]
then
  echo "the prepared proof run bundle changed before the proof job" >&2
  exit 1
fi
test_executable=$(raziel_prepared_test_executable_path "$run_bundle")
guest_elf=$(raziel_guest_elf_path "$run_bundle")
raziel_verify_plonk_setup "$repo_root"
if [ "$prepared_test_executable_sha256" != "$(raziel_sha256_file "$test_executable")" ]; then
  echo "the prepared proof-test executable changed before the proof job" >&2
  exit 1
fi
if [ "$prepared_guest_elf_sha256" != "$(raziel_sha256_file "$guest_elf")" ]; then
  echo "the prepared authorization guest ELF changed before the proof job" >&2
  exit 1
fi
if [ "$prepared_setup_manifest_sha256" != \
  "$(raziel_sha256_file tools/sp1-plonk-files.sha256)" ]
then
  echo "the prepared Plonk setup manifest changed before the proof job" >&2
  exit 1
fi

report_id="cluster-$(date -u +%Y%m%dT%H%M%SZ)-$$"
report_directory=.sp1/benchmarks
report_in_progress="$report_directory/$report_id.in-progress.log"
report_pass="$report_directory/$report_id.pass.log"
report_fail="$report_directory/$report_id.fail.log"
mkdir -p "$report_directory"
chmod 700 "$report_directory"

run_offline_benchmark() {
  printf 'benchmark_profile=%s\n' "$RAZIEL_SP1_BENCHMARK_PROFILE"
  printf 'cluster_name=%s\n' "$RAZIEL_CLUSTER_NAME"
  printf 'cluster_scheduler=%s\n' "$RAZIEL_CLUSTER_SCHEDULER"
  printf 'source_git_commit=%s\n' "$prepared_commit"
  printf 'source_git_tree=%s\n' "$prepared_tree"
  printf 'source_git_status=clean\n'
  printf 'container_runtime=%s\n' "$runtime"
  printf 'container_runtime_version=%s\n' "$current_runtime_version"
  printf 'toolchain_image_id=%s\n' "$prepared_image_id"
  printf 'run_bundle_manifest_sha256=%s\n' \
    "$prepared_run_bundle_manifest_sha256"
  printf 'host_kernel_name=%s\n' "$(uname -s)"
  printf 'host_kernel_release=%s\n' "$(uname -r)"
  printf 'host_architecture=%s\n' "$(uname -m)"

  case "$runtime" in
    docker)
      export HOST_UID=$(id -u)
      export HOST_GID=$(id -g)
      export RAZIEL_SP1_WORKSPACE_SOURCE="$run_bundle"
      docker compose \
        --env-file tools/toolchain-versions.env \
        --profile benchmark \
        run --rm sp1-plonk-benchmark
      ;;
    apptainer | singularity)
      setup_path="$repo_root/.sp1/circuits/plonk/v6.1.0"
      "$runtime" exec \
        --cleanenv \
        --containall \
        --net \
        --network none \
        --no-eval \
        --no-mount hostfs,home,cwd \
        --memory "$RAZIEL_SP1_EXPECTED_MEMORY_MAX_BYTES" \
        --memory-swap "$RAZIEL_SP1_EXPECTED_MEMORY_MAX_BYTES" \
        --bind "$run_bundle:/workspace:ro" \
        --bind "$setup_path:/opt/sp1/circuits/plonk/v6.1.0:ro" \
        --pwd /workspace \
        --env CARGO_NET_OFFLINE=true \
        --env GODEBUG=gctrace=1 \
        --env GOMAXPROCS="$RAZIEL_SP1_WORKER_THREADS" \
        --env GOMEMLIMIT="$RAZIEL_SP1_GO_MEMORY_LIMIT" \
        --env HOME=/tmp/raziel-home \
        --env RAYON_NUM_THREADS="$RAZIEL_SP1_WORKER_THREADS" \
        --env RAZIEL_SP1_BENCHMARK_PROFILE="$RAZIEL_SP1_BENCHMARK_PROFILE" \
        --env RAZIEL_SP1_EXPECTED_GO_MEMORY_LIMIT="$RAZIEL_SP1_GO_MEMORY_LIMIT" \
        --env RAZIEL_SP1_EXPECTED_GO_DEBUG=gctrace=1 \
        --env RAZIEL_SP1_EXPECTED_MEMORY_MAX_BYTES="$RAZIEL_SP1_EXPECTED_MEMORY_MAX_BYTES" \
        --env RAZIEL_SP1_EXPECTED_VISIBLE_CPUS=4 \
        --env RAZIEL_SP1_EXPECTED_WORKER_THREADS="$RAZIEL_SP1_WORKER_THREADS" \
        --env SP1_PLONK_CIRCUIT_PATH=/opt/sp1/circuits/plonk \
        "$RAZIEL_SP1_TOOLCHAIN_SIF" \
        ./scripts/run-sp1-plonk-benchmark
      ;;
  esac
}

set +e
(
  set -eu
  run_offline_benchmark
) >"$report_in_progress" 2>&1
status=$?
set -e
cat "$report_in_progress"
if [ "$status" -eq 0 ]; then
  mv "$report_in_progress" "$report_pass"
  printf 'benchmark_report=%s\n' "$report_pass"
  ./scripts/cluster/render-sp1-plonk-result "$report_pass"
else
  mv "$report_in_progress" "$report_fail"
  printf 'benchmark_report=%s\n' "$report_fail"
  exit "$status"
fi
