#!/bin/sh
set -eu

if [ "$#" -ne 2 ]; then
  echo "usage: stage-retained-sp1-plonk REPORT PUBLIC_OUTPUT_DIRECTORY" >&2
  exit 1
fi

script_directory=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$script_directory/sp1-plonk-common"

repo_root=$(CDPATH= cd -- "$script_directory/../.." && pwd)
cd "$repo_root"
umask 077

case "$1" in
  /*) report_path=$1 ;;
  *) report_path="$repo_root/$1" ;;
esac
case "$2" in
  /*) public_output=$2 ;;
  *) public_output="$repo_root/$2" ;;
esac

if [ ! -f "$report_path" ] || [ -L "$report_path" ]; then
  echo "retained proof report is missing or linked" >&2
  exit 1
fi
if [ ! -d "$public_output" ] || [ -L "$public_output" ]; then
  echo "retained public output is missing or linked" >&2
  exit 1
fi

required_value() {
  key=$1
  count=$(awk -v prefix="$key=" 'index($0, prefix) == 1 { count++ } END { print count + 0 }' "$report_path")
  if [ "$count" != 1 ]; then
    echo "benchmark report must contain one $key field" >&2
    exit 1
  fi
  awk -v prefix="$key=" 'index($0, prefix) == 1 { print substr($0, length(prefix) + 1) }' "$report_path"
}

required_line() {
  prefix=$1
  test_name=$2
  test_harness_prefix="test $test_name ... "
  line=$(
    awk -v prefix="$prefix" -v test_harness_prefix="$test_harness_prefix" '
      index($0, prefix) == 1 {
        value = $0
        count += 1
      }
      index($0, test_harness_prefix prefix) == 1 {
        value = substr($0, length(test_harness_prefix) + 1)
        count += 1
      }
      END {
        if (count != 1 || value == "") {
          exit 1
        }
        print value
      }
    ' "$report_path"
  ) || {
    echo "benchmark report has a missing or duplicated $prefix gate line" >&2
    exit 1
  }
  printf '%s\n' "$line"
}

require_digest() {
  label=$1
  value=$2
  if ! printf '%s\n' "$value" | grep -Eq '^[0-9a-f]{64}$'; then
    echo "$label must be a lowercase SHA-256 digest" >&2
    exit 1
  fi
}

require_positive_integer() {
  label=$1
  value=$2
  case "$value" in
    *[!0-9]* | "" | 0)
      echo "$label must be a positive integer" >&2
      exit 1
      ;;
  esac
}

require_git_oid() {
  label=$1
  value=$2
  case "${#value}" in
    40 | 64) require_digest_value_length=${#value} ;;
    *) echo "$label has the wrong Git object-ID length" >&2; exit 1 ;;
  esac
  if ! printf '%s\n' "$value" | grep -Eq "^[0-9a-f]{$require_digest_value_length}$"; then
    echo "$label must be a lowercase Git object ID" >&2
    exit 1
  fi
}

expected_files=$(mktemp /tmp/raziel-retained-proof-expected.XXXXXX)
actual_files=$(mktemp /tmp/raziel-retained-proof-actual.XXXXXX)
staging_path=
cleanup_stage() {
  rm -f "$expected_files" "$actual_files"
  if [ -n "$staging_path" ]; then
    rm -rf "$staging_path"
  fi
}
trap cleanup_stage EXIT HUP INT TERM

printf '%s\n' \
  plonk-proof.bin \
  public-values.bin \
  sp1-vkey-hash.txt \
  verification-key-id.txt \
  >"$expected_files"
find "$public_output" -mindepth 1 -maxdepth 1 -print |
  sed 's#^.*/##' |
  LC_ALL=C sort >"$actual_files"
if ! cmp -s "$expected_files" "$actual_files"; then
  echo "retained output does not match the public four-file allowlist" >&2
  exit 1
fi
if find "$public_output" ! -type d ! -type f -print -quit | grep -q .; then
  echo "retained output contains a linked or special entry" >&2
  exit 1
fi

for public_file in \
  plonk-proof.bin \
  public-values.bin \
  sp1-vkey-hash.txt \
  verification-key-id.txt
do
  file_path="$public_output/$public_file"
  if [ ! -f "$file_path" ] || [ -L "$file_path" ]; then
    echo "retained public file is missing or linked: $public_file" >&2
    exit 1
  fi
done

proof_bytes=$(wc -c <"$public_output/plonk-proof.bin" | tr -d ' ')
public_values_bytes=$(wc -c <"$public_output/public-values.bin" | tr -d ' ')
require_positive_integer proof_artifact_bytes "$proof_bytes"
require_positive_integer public_values_bytes "$public_values_bytes"
if [ "$proof_bytes" -gt 1048576 ] || [ "$public_values_bytes" -gt 4096 ]; then
  echo "retained public proof output exceeds its protocol ceiling" >&2
  exit 1
fi

verification_key_id=$(cat "$public_output/verification-key-id.txt")
sp1_vkey_hash=$(cat "$public_output/sp1-vkey-hash.txt")
if [ "$(wc -l <"$public_output/verification-key-id.txt" | tr -d ' ')" -gt 0 ] ||
  [ "$(wc -l <"$public_output/sp1-vkey-hash.txt" | tr -d ' ')" -gt 0 ] ||
  ! printf '%s\n' "$verification_key_id" | grep -Eq '^sp1-vk-v1:[0-9a-f]{64}$' ||
  ! printf '%s\n' "$sp1_vkey_hash" | grep -Eq '^0x[0-9a-f]{64}$'
then
  echo "retained public verification-key identity is invalid" >&2
  exit 1
fi

if [ "$(required_value b0031_public_export)" != pass ]; then
  echo "benchmark report does not contain the approved public export gate" >&2
  exit 1
fi
prove_gate=$(required_line \
  adr_0012_prove: \
  local_plonk_proof_passes_the_adr_0012_generation_gate)
verify_gate=$(required_line \
  adr_0012_verify: \
  local_plonk_verification_passes_the_adr_0012_gate)
if ! printf '%s\n' "$prove_gate" | grep -Eq '^adr_0012_prove: proof_mode=plonk, prove_ms=[0-9]+, artifact_bytes=[0-9]+, verification_key_id=sp1-vk-v1:[0-9a-f]{64}$' ||
  ! printf '%s\n' "$verify_gate" | grep -Eq '^adr_0012_verify: proof_mode=plonk, verify_ms=[0-9]+, verification_key_id=sp1-vk-v1:[0-9a-f]{64}$'
then
  echo "benchmark report contains a malformed proof or verification gate" >&2
  exit 1
fi
reported_key_id=$(printf '%s\n' "$prove_gate" | sed -E 's/.*verification_key_id=([^, ]+)$/\1/')
verified_key_id=$(printf '%s\n' "$verify_gate" | sed -E 's/.*verification_key_id=([^, ]+)$/\1/')
reported_proof_bytes=$(printf '%s\n' "$prove_gate" | sed -E 's/.*artifact_bytes=([0-9]+),.*/\1/')
prove_ms=$(printf '%s\n' "$prove_gate" | sed -E 's/.*prove_ms=([0-9]+),.*/\1/')
verify_ms=$(printf '%s\n' "$verify_gate" | sed -E 's/.*verify_ms=([0-9]+),.*/\1/')
if [ "$verification_key_id" != "$reported_key_id" ] ||
  [ "$verification_key_id" != "$verified_key_id" ] ||
  [ "$proof_bytes" != "$reported_proof_bytes" ]
then
  echo "retained proof output does not match the benchmark gates" >&2
  exit 1
fi

source_commit=$(required_value source_git_commit)
source_tree=$(required_value source_git_tree)
source_manifest=$(required_value source_manifest_sha256)
run_bundle_manifest=$(required_value run_bundle_manifest_sha256)
toolchain_image=$(required_value toolchain_image_id)
benchmark_utc=$(required_value benchmark_utc)
benchmark_profile=$(required_value benchmark_profile)
proof_memory_peak=$(required_value container_memory_peak_bytes)
proof_swap_peak=$(required_value container_swap_peak_bytes)
require_git_oid source_git_commit "$source_commit"
require_git_oid source_git_tree "$source_tree"
if [ "${#source_commit}" -ne "${#source_tree}" ]; then
  echo "retained proof source object IDs use different formats" >&2
  exit 1
fi
require_digest source_manifest_sha256 "$source_manifest"
require_digest run_bundle_manifest_sha256 "$run_bundle_manifest"
case "$toolchain_image" in
  sha256:*) require_digest toolchain_image_id "${toolchain_image#sha256:}" ;;
  *) echo "retained proof toolchain image identity is invalid" >&2; exit 1 ;;
esac
if [ "$benchmark_profile" != cluster-56g-8cpu ] ||
  ! printf '%s\n' "$benchmark_utc" | grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$'
then
  echo "retained proof benchmark identity is invalid" >&2
  exit 1
fi
for measured_value in "$prove_ms" "$verify_ms" "$proof_memory_peak"; do
  require_positive_integer benchmark_measurement "$measured_value"
done
case "$proof_swap_peak" in
  *[!0-9]* | "") echo "proof swap peak must be an integer" >&2; exit 1 ;;
esac
if [ "$proof_swap_peak" != 0 ]; then
  echo "retained proof run used swap" >&2
  exit 1
fi

proof_sha256=$(raziel_sha256_file "$public_output/plonk-proof.bin")
public_values_sha256=$(raziel_sha256_file "$public_output/public-values.bin")
fixture_parent=${RAZIEL_RETAINED_PLONK_FIXTURE_ROOT:-"$repo_root/services/verifierd/tests/fixtures"}
if [ "$fixture_parent" != "$repo_root/services/verifierd/tests/fixtures" ] &&
  [ "${RAZIEL_CLUSTER_PLUMBING_SELF_TEST:-0}" != 1 ]
then
  echo "retained fixture destination override is limited to the plumbing self-test" >&2
  exit 1
fi
fixture_path="$fixture_parent/retained-plonk-v1"
if [ -e "$fixture_path" ] || [ -L "$fixture_path" ]; then
  echo "retained Plonk fixture already exists and will not be replaced" >&2
  exit 1
fi
mkdir -p "$fixture_parent"
staging_path=$(mktemp -d "$fixture_parent/.retained-plonk-v1.XXXXXX")
for public_file in \
  plonk-proof.bin \
  public-values.bin \
  sp1-vkey-hash.txt \
  verification-key-id.txt
do
  install -m 0644 "$public_output/$public_file" "$staging_path/$public_file"
done
(
  cd "$staging_path"
  sha256sum \
    plonk-proof.bin \
    public-values.bin \
    sp1-vkey-hash.txt \
    verification-key-id.txt \
    >SHA256SUMS
)
chmod 0644 "$staging_path/SHA256SUMS"
{
  printf 'format_version=1\n'
  printf 'classification=public-zero-knowledge-test-fixture\n'
  printf 'fixture_id=direct\n'
  printf 'proof_system=sp1-plonk\n'
  printf 'source_git_commit=%s\n' "$source_commit"
  printf 'source_git_tree=%s\n' "$source_tree"
  printf 'source_manifest_sha256=%s\n' "$source_manifest"
  printf 'run_bundle_manifest_sha256=%s\n' "$run_bundle_manifest"
  printf 'toolchain_image_id=%s\n' "$toolchain_image"
  printf 'benchmark_profile=%s\n' "$benchmark_profile"
  printf 'proof_generated_utc=%s\n' "$benchmark_utc"
  printf 'prove_ms=%s\n' "$prove_ms"
  printf 'baseline_verify_ms=%s\n' "$verify_ms"
  printf 'proof_artifact_bytes=%s\n' "$proof_bytes"
  printf 'proof_artifact_sha256=%s\n' "$proof_sha256"
  printf 'public_values_bytes=%s\n' "$public_values_bytes"
  printf 'public_values_sha256=%s\n' "$public_values_sha256"
  printf 'verification_key_id=%s\n' "$verification_key_id"
  printf 'sp1_vkey_hash=%s\n' "$sp1_vkey_hash"
  printf 'proof_memory_peak_bytes=%s\n' "$proof_memory_peak"
  printf 'proof_swap_peak_bytes=%s\n' "$proof_swap_peak"
  printf 'private_witness_retained=false\n'
  printf 'debug_trace_retained=false\n'
} >"$staging_path/PROVENANCE"
chmod 0644 "$staging_path/PROVENANCE"
mv "$staging_path" "$fixture_path"
staging_path=

printf 'retained_public_fixture=%s\n' "${fixture_path#"$repo_root/"}"
printf 'retained_public_fixture_sha256=%s\n' "$proof_sha256"
