#!/bin/sh
#SBATCH --job-name=raziel-sp1-prepare
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --time=02:00:00
#SBATCH --export=ALL
#SBATCH --output=/dev/null

set -eu
umask 077

cd "${SLURM_SUBMIT_DIR:?SLURM_SUBMIT_DIR is required}"
mkdir -p .sp1/slurm-logs
chmod 700 .sp1 .sp1/slurm-logs
exec >".sp1/slurm-logs/raziel-sp1-prepare-${SLURM_JOB_ID:?}.log" 2>&1
exec ./scripts/cluster/prepare-sp1-plonk
