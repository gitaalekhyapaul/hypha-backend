#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$repo_root"

recover_duplicate_profile=0
if [ "$#" -eq 2 ] && [ "$1" = --recover-duplicate-profile ]; then
  recover_duplicate_profile=1
  shift
fi
if [ "$#" -ne 1 ]; then
  echo "usage: $0 [--recover-duplicate-profile] .sp1/benchmarks/<id>.pass.log" >&2
  exit 1
fi
report_path=$1
case "$report_path" in
  .sp1/benchmarks/*.pass.log) ;;
  *)
    echo "result input must be a successful ignored benchmark log" >&2
    exit 1
    ;;
esac
if [ ! -f "$report_path" ]; then
  echo "benchmark log does not exist: $report_path" >&2
  exit 1
fi

required_value() {
  key=$1
  expected_count=1
  if [ "$recover_duplicate_profile" -eq 1 ] && [ "$key" = benchmark_profile ]; then
    expected_count=2
  fi
  value=$(
    awk -v expected_count="$expected_count" -v prefix="$key=" '
      index($0, prefix) == 1 {
        current = substr($0, length(prefix) + 1)
        if (count == 0) {
          value = current
        } else if (current != value) {
          conflict = 1
        }
        count += 1
      }
      END {
        if (count != expected_count || conflict || value == "") {
          exit 1
        }
        print value
      }
    ' "$report_path"
  ) || {
    echo "benchmark log has a missing, empty, conflicting, or duplicated $key value" >&2
    exit 1
  }
  printf '%s\n' "$value"
}

required_line() {
  prefix=$1
  line=$(
    awk -v prefix="$prefix" '
      index($0, prefix) == 1 {
        value = $0
        count += 1
      }
      END {
        if (count != 1 || value == "") {
          exit 1
        }
        print value
      }
    ' "$report_path"
  ) || {
    echo "benchmark log has no $prefix gate line" >&2
    exit 1
  }
  printf '%s\n' "$line"
}

require_lower_hex() {
  field_name=$1
  value=$2
  expected_length=$3
  case "$value" in
    *[!0-9a-f]* | "")
      echo "$field_name is not lowercase hexadecimal" >&2
      exit 1
      ;;
  esac
  if [ "${#value}" -ne "$expected_length" ]; then
    echo "$field_name has the wrong length" >&2
    exit 1
  fi
}

require_git_oid() {
  field_name=$1
  value=$2
  case "${#value}" in
    40 | 64) ;;
    *)
      echo "$field_name has the wrong Git object-ID length" >&2
      exit 1
      ;;
  esac
  require_lower_hex "$field_name" "$value" "${#value}"
}

require_markdown_safe() {
  field_name=$1
  value=$2
  if ! printf '%s\n' "$value" | LC_ALL=C grep -Eq '^[[:print:]]+$'; then
    echo "$field_name contains a control character" >&2
    exit 1
  fi
  case "$value" in
    *'`'* | *'|'* | *'<'* | *'>'*)
      echo "$field_name contains unsafe Markdown punctuation" >&2
      exit 1
      ;;
  esac
}

require_gate_line() {
  field_name=$1
  value=$2
  pattern=$3
  if ! printf '%s\n' "$value" | LC_ALL=C grep -Eq "$pattern"; then
    echo "$field_name does not match the approved ADR-0012 gate format" >&2
    exit 1
  fi
}

report_id=$(basename "$report_path" .pass.log)
case "$report_id" in
  *[!A-Za-z0-9._-]* | "")
    echo "benchmark result identifier contains unsupported characters" >&2
    exit 1
    ;;
esac
source_commit=$(required_value source_git_commit)
source_tree=$(required_value source_git_tree)
source_status=$(required_value source_git_status)
cluster_name=$(required_value cluster_name)
cluster_scheduler=$(required_value cluster_scheduler)
runtime=$(required_value container_runtime)
runtime_version=$(required_value container_runtime_version)
toolchain_image_id=$(required_value toolchain_image_id)
benchmark_utc=$(required_value benchmark_utc)
benchmark_profile=$(required_value benchmark_profile)
architecture=$(required_value architecture)
kernel_release=$(required_value kernel_release)
cpu_model=$(required_value cpu_model)
available_cpus=$(required_value available_cpus)
cpu_max=$(required_value cpu_max)
memory_max=$(required_value container_memory_max_bytes)
memory_peak=$(required_value container_memory_peak_bytes)
swap_max=$(required_value container_swap_max_bytes)
swap_peak=$(required_value container_swap_peak_bytes)
oom_count=$(required_value container_oom_count)
oom_kill_count=$(required_value container_oom_kill_count)
go_max_procs=$(required_value go_max_procs)
go_memory_limit=$(required_value go_memory_limit)
go_debug=$(required_value go_debug)
rayon_threads=$(required_value rayon_threads)
rustc_version=$(required_value rustc_version)
cargo_version=$(required_value cargo_version)
cargo_prove_version=$(required_value cargo_prove_version)
setup_sha256=$(required_value sp1_plonk_setup_archive_sha256)
source_manifest_sha256=$(required_value source_manifest_sha256)
run_bundle_manifest_sha256=$(required_value run_bundle_manifest_sha256)
execute_gate=$(required_line adr_0012_execute:)
prove_gate=$(required_line adr_0012_prove:)
verify_gate=$(required_line adr_0012_verify:)
mutations=$(required_value adr_0012_mutations)

require_git_oid source_git_commit "$source_commit"
require_git_oid source_git_tree "$source_tree"
if [ "${#source_commit}" -ne "${#source_tree}" ]; then
  echo "source Git object IDs use different formats" >&2
  exit 1
fi
require_lower_hex source_manifest_sha256 "$source_manifest_sha256" 64
require_lower_hex run_bundle_manifest_sha256 "$run_bundle_manifest_sha256" 64
require_lower_hex sp1_plonk_setup_archive_sha256 "$setup_sha256" 64
case "$toolchain_image_id" in
  sha256:*) ;;
  *)
    echo "toolchain image identity is not a SHA-256 digest" >&2
    exit 1
    ;;
esac
require_lower_hex toolchain_image_id "${toolchain_image_id#sha256:}" 64

for safe_value in \
  "$benchmark_utc" \
  "$benchmark_profile" \
  "$architecture" \
  "$kernel_release" \
  "$cpu_model" \
  "$cpu_max" \
  "$go_memory_limit" \
  "$go_debug" \
  "$runtime_version" \
  "$rustc_version" \
  "$cargo_version" \
  "$cargo_prove_version"
do
  require_markdown_safe "benchmark report field" "$safe_value"
done

if ! printf '%s\n' "$benchmark_utc" |
  LC_ALL=C grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$'
then
  echo "benchmark UTC timestamp has the wrong format" >&2
  exit 1
fi
case "$architecture" in
  x86_64 | aarch64) ;;
  *)
    echo "benchmark architecture is unsupported" >&2
    exit 1
    ;;
esac
case "$cluster_name:$cluster_scheduler:$runtime" in
  nus:slurm:apptainer | nus:slurm:singularity | independent:unscheduled:docker) ;;
  *)
    echo "cluster, scheduler, and runtime do not match an approved execution path" >&2
    exit 1
    ;;
esac

require_gate_line \
  adr_0012_execute \
  "$execute_gate" \
  '^adr_0012_execute: proof_mode=plonk, fixture_id=direct, instructions=422138, execute_ms=[0-9]+$'
require_gate_line \
  adr_0012_prove \
  "$prove_gate" \
  '^adr_0012_prove: proof_mode=plonk, prove_ms=[0-9]+, artifact_bytes=[0-9]+, verification_key_id=sp1-vk-v1:[0-9a-f]{64}$'
require_gate_line \
  adr_0012_verify \
  "$verify_gate" \
  '^adr_0012_verify: proof_mode=plonk, verify_ms=[0-9]+, verification_key_id=sp1-vk-v1:[0-9a-f]{64}$'
prove_key_id=${prove_gate##*verification_key_id=}
verify_key_id=${verify_gate##*verification_key_id=}
if [ "$prove_key_id" != "$verify_key_id" ]; then
  echo "proof and verification gates report different verification keys" >&2
  exit 1
fi
prove_ms=$(printf '%s\n' "$prove_gate" | sed -E 's/.*prove_ms=([0-9]+),.*/\1/')
artifact_bytes=$(printf '%s\n' "$prove_gate" | sed -E 's/.*artifact_bytes=([0-9]+),.*/\1/')
verify_ms=$(printf '%s\n' "$verify_gate" | sed -E 's/.*verify_ms=([0-9]+),.*/\1/')

for integer_value in \
  "$available_cpus" \
  "$memory_max" \
  "$memory_peak" \
  "$swap_max" \
  "$swap_peak" \
  "$oom_count" \
  "$oom_kill_count" \
  "$go_max_procs" \
  "$rayon_threads"
do
  case "$integer_value" in
    *[!0-9]* | "")
      echo "benchmark result contains an invalid integer" >&2
      exit 1
      ;;
    esac
done
for integer_value in "$prove_ms" "$artifact_bytes" "$verify_ms"; do
  case "$integer_value" in
    *[!0-9]* | "")
      echo "proof gate contains an invalid integer" >&2
      exit 1
      ;;
  esac
done

if [ "$source_status" != clean ] ||
  [ "$benchmark_profile" != cluster-56g ] ||
  [ "$memory_max" != 60129542144 ] ||
  [ "$swap_max" != 0 ] ||
  [ "$swap_peak" != 0 ] ||
  [ "$oom_count" != 0 ] ||
  [ "$oom_kill_count" != 0 ] ||
  [ "$go_max_procs" != 4 ] ||
  [ "$go_memory_limit" != 24GiB ] ||
  [ "$go_debug" != gctrace=1 ] ||
  [ "$rayon_threads" != 4 ] ||
  [ "$mutations" != pass ]
then
  echo "benchmark result does not meet the approved cluster-56g pass profile" >&2
  exit 1
fi
if [ "$available_cpus" != 4 ] ||
  [ "$memory_peak" -gt "$memory_max" ] ||
  [ "$prove_ms" -gt 3600000 ] ||
  [ "$artifact_bytes" -gt 1048576 ] ||
  [ "$verify_ms" -gt 60000 ]
then
  echo "benchmark result exceeds an ADR-0012 resource or timing ceiling" >&2
  exit 1
fi

result_directory=docs/benchmarks/sp1-plonk
result_path="$result_directory/$report_id.md"
mkdir -p "$result_directory"
if [ -e "$result_path" ]; then
  echo "benchmark result already exists: $result_path" >&2
  exit 1
fi

{
  printf '# SP1 Plonk Cluster Benchmark: %s\n\n' "$report_id"
  printf -- '- Status: pass\n'
  printf -- '- Benchmark UTC: `%s`\n' "$benchmark_utc"
  printf -- '- Cluster: `%s`\n' "$cluster_name"
  printf -- '- Scheduler: `%s`\n' "$cluster_scheduler"
  printf -- '- Source commit: `%s`\n' "$source_commit"
  printf -- '- Source tree: `%s`\n' "$source_tree"
  printf -- '- Source manifest SHA-256: `%s`\n' "$source_manifest_sha256"
  printf -- '- Run bundle manifest SHA-256: `%s`\n\n' "$run_bundle_manifest_sha256"
  printf '## Proof Gates\n\n'
  printf '```text\n%s\n%s\n%s\n' "$execute_gate" "$prove_gate" "$verify_gate"
  printf 'adr_0012_mutations=%s\n```\n\n' "$mutations"
  printf '## Resource Evidence\n\n'
  printf '| Field | Value |\n'
  printf '| --- | --- |\n'
  printf '| Benchmark profile | `%s` |\n' "$benchmark_profile"
  printf '| Architecture | `%s` |\n' "$architecture"
  printf '| Kernel release | `%s` |\n' "$kernel_release"
  printf '| CPU model | `%s` |\n' "$cpu_model"
  printf '| Visible CPUs | `%s` |\n' "$available_cpus"
  printf '| Cgroup CPU maximum | `%s` |\n' "$cpu_max"
  printf '| Memory limit bytes | `%s` |\n' "$memory_max"
  printf '| Peak memory bytes | `%s` |\n' "$memory_peak"
  printf '| Swap limit bytes | `%s` |\n' "$swap_max"
  printf '| Peak swap bytes | `%s` |\n' "$swap_peak"
  printf '| OOM events | `%s` |\n' "$oom_count"
  printf '| OOM kills | `%s` |\n' "$oom_kill_count"
  printf '| Go processes | `%s` |\n' "$go_max_procs"
  printf '| Go memory target | `%s` |\n' "$go_memory_limit"
  printf '| Go memory diagnostics | `%s` |\n' "$go_debug"
  printf '| Rayon threads | `%s` |\n\n' "$rayon_threads"
  printf '## Toolchain Evidence\n\n'
  printf '| Field | Value |\n'
  printf '| --- | --- |\n'
  printf '| Runtime | `%s` |\n' "$runtime"
  printf '| Runtime version | `%s` |\n' "$runtime_version"
  printf '| Toolchain image | `%s` |\n' "$toolchain_image_id"
  printf '| Rust | `%s` |\n' "$rustc_version"
  printf '| Cargo | `%s` |\n' "$cargo_version"
  printf '| cargo-prove | `%s` |\n' "$cargo_prove_version"
  printf '| Plonk setup archive SHA-256 | `%s` |\n\n' "$setup_sha256"
  printf 'The raw scheduler and benchmark logs stay under `.sp1/` or use a `.log` suffix. '
  printf 'Git ignores both locations. The proof, public journal, and witness are deleted '
  printf 'inside the isolated proof process.\n'
} >"$result_path"

printf 'public_benchmark_result=%s\n' "$result_path"
