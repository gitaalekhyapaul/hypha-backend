# Copy this file to .env. Replace HOST_UID and HOST_GID with `id -u` and `id -g`.
# Replace both absolute key paths, then pass the file after the pinned toolchain file:
# ./scripts/compose --env-file .env --profile services up

HOST_UID=REPLACE_WITH_ID_U
HOST_GID=REPLACE_WITH_ID_G
RAZIEL_TRUST_DOMAIN_ID=raziel-local-dev
RAZIEL_REGISTRY_PATH=./.raziel/state/registry
RAZIEL_QUEUE_PREFIX=raziel-capabilities

# Keep private keys outside the repository and restrict each file to mode 0400.
RAZIEL_POLICY_KEY_PATH=/absolute/path/to/policy-authority.pk8
RAZIEL_SNAPSHOT_KEY_PATH=/absolute/path/to/snapshot-authority.pk8
